# IRONLOOM Environment Configuration
PORT=3000
NODE_ENV=development
API_PREFIX=api/v1

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Supabase / PostgreSQL Configuration
# For local development with Docker / Supabase CLI or hosted Supabase
SUPABASE_URL=http://localhost:54321
SUPABASE_ANON_KEY=eyJhYmdjZGVm...
SUPABASE_SERVICE_ROLE_KEY=eyJhYmdjZGVm...
DATABASE_URL=postgresql://postgres:postgres@localhost:54322/postgres

# AI Gateway Providers
# 1. Ollama (Local Zero-Cost LLM)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_DEFAULT_MODEL=llama3.1
OLLAMA_TIMEOUT_MS=60000

# 2. Groq (Free Tier Hosted LLM)
# Obtain a free key from https://console.groq.com/keys
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_DEFAULT_MODEL=llama-3.3-70b-versatile
GROQ_TIMEOUT_MS=30000

# Gateway Failover & Retry
GATEWAY_MAX_RETRIES=2
GATEWAY_RETRY_DELAY_MS=1000
GATEWAY_DEFAULT_PROVIDER=ollama
GATEWAY_FALLBACK_PROVIDERS=groq

# Rate Limiting (Requests per minute for public API)
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=100
